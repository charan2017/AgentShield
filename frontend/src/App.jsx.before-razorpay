                disabled={
                  Boolean(result)
                }
                onChange={(event) =>
                  updateField(
                    "category",
                    event.target.value
                  )
                }
              >

                <option value="personal_transfer">
                  Personal Transfer
                </option>

                <option value="food">
                  Food
                </option>

                <option value="shopping">
                  Shopping
                </option>

                <option value="subscription">
                  Subscription
                </option>

                <option value="travel">
                  Travel
                </option>

              </select>

            </div>

            <FormField
              label="INTENT ID"
              value={
                form.intent_id
              }
              disabled={
                Boolean(result)
              }
              onChange={(value) =>
                updateField(
                  "intent_id",
                  value
