      {error && (
        <div className="glass-alert error-alert">

          <AlertTriangle
            size={15}
          />

          <span>
            {error}
          </span>

          <button
            type="button"
            onClick={() =>
              setError("")
            }
          >
            <X size={14} />
          </button>

        </div>
      )}

      <section className="glass-panel">

        <PanelHeader
          eyebrow="PENDING REVIEWS"
          title="Human approval queue"
          right={
            <span className="queue-count-large">
