                    value
                  )
                }
              />

              <FormField
                label="SESSION"
                value={
                  form.session_id
                }
                disabled={
                  Boolean(result)
                }
                onChange={(value) =>
                  updateField(
                    "session_id",
                    value
                  )
                }
              />

            </div>

            <div className="form-field">

              <label>
                CATEGORY
