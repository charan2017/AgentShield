function LedgerPage({
  ledger,
  selectedEvent,
  onSelectEvent,
}) {
  const [query, setQuery] =
    useState("");

  const [filter, setFilter] =
    useState("ALL");

  const filtered =
    useMemo(() => {
      const search =
        query
          .trim()
          .toLowerCase();

      return ledger
        .slice()
        .reverse()
        .filter((event) => {

          const decision =
            decisionFromEvent(
              event
            );

          if (
            filter !==
              "ALL" &&
            decision !==
              filter
          ) {
            return false;
          }

          if (!search) {
            return true;
          }

          return (
            String(
              event.event_type ||
                ""
            )
              .toLowerCase()
              .includes(
                search
              ) ||

            String(
              event.message ||
                ""
            )
              .toLowerCase()
              .includes(
                search
              ) ||

            String(
              event.agent_id ||
                ""
            )
              .toLowerCase()
              .includes(
                search
              ) ||

            String(
              event.intent_id ||
                ""
            )
              .toLowerCase()
              .includes(
                search
              )
